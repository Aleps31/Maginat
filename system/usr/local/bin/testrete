#!/bin/bash
echo "--- interfaccia ---"
ip addr show ens3 | grep -E 'inet |state'
echo "--- gateway ---"
ping -c 2 10.0.2.2 | tail -n 2
echo "--- DNS ---"
getent hosts archlinux.org || echo "DNS non funziona"
echo "--- TCP verso Internet ---"
timeout 15 bash -c 'exec 3<>/dev/tcp/archlinux.org/80 && printf "GET / HTTP/1.0\r\nHost: archlinux.org\r\n\r\n" >&3 && head -n 1 <&3' || echo "connessione TCP fallita"
