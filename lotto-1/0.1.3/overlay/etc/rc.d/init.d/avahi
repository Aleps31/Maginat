#!/bin/sh
. /lib/lsb/init-functions
case "${1}" in
   start)
      log_info_msg "Avvio di Avahi..."
      /usr/sbin/avahi-daemon -D
      evaluate_retval
      ;;
   stop)
      log_info_msg "Arresto di Avahi..."
      /usr/sbin/avahi-daemon -k
      evaluate_retval
      ;;
   restart)
      ${0} stop; sleep 1; ${0} start
      ;;
   *)
      echo "Uso: ${0} {start|stop|restart}"
      exit 1
      ;;
esac
