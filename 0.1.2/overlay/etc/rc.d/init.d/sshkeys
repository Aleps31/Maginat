#!/bin/sh
########################################################################
# Begin sshkeys
#
# Description : genera le chiavi SSH dell'host a ogni avvio
########################################################################

### BEGIN INIT INFO
# Provides:            sshkeys
# Required-Start:      $local_fs
# Default-Start:       2 3 4 5
# Short-Description:   Genera le chiavi SSH dell'host
# X-LFS-Provided-By:   Maginat
### END INIT INFO

. /lib/lsb/init-functions

case "${1}" in
   start)
      log_info_msg "Generazione delle chiavi SSH dell'host..."
      ssh-keygen -A > /dev/null 2>&1
      evaluate_retval
      ;;
   *)
      echo "Uso: ${0} {start}"
      exit 1
      ;;
esac

# End sshkeys
