#!/bin/bash
case "$LANG" in it*) N="Nessuna webcam trovata.";; *) N="No webcam found.";; esac
D=$(ls /dev/video* 2>/dev/null | head -1)
if [ -z "$D" ]; then
  yad --title=Webcam --image=dialog-warning --text="$N" --center --button=OK:0
  exit 0
fi
exec gst-launch-1.0 -q v4l2src device="$D" ! videoconvert ! autovideosink
