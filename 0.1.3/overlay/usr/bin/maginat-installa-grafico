if [ "$(id -u)" -ne 0 ]; then
  exec sudo env DISPLAY="$DISPLAY" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" "$0" "$@"
fi
. /usr/share/maginat/i18n.sh
IT['A light and clean desktop']="Un desktop leggero e pulito"
IT['Xfce on a Linux built from scratch: fast, simple and made to last.']="Xfce su un Linux costruito da zero: veloce, semplice e fatto per durare."
IT['Thousands of programs']="Migliaia di programmi"
IT['Install apps from the Maginat Store with a click.']="Installa le app dal Negozio di Maginat con un clic."
IT['Games included']="Giochi inclusi"
IT['Relax with the games that come with Maginat.']="Rilassati con i giochi che trovi già in Maginat."
IT['Make it yours']="Rendilo tuo"
IT['Choose from many wallpapers and change the look of your desktop.']="Scegli tra tanti sfondi e cambia l'aspetto del desktop."
IT['Everything at hand']="Tutto a portata di mano"
IT['Clock, battery, network and quick links in one panel.']="Orologio, batteria, rete e collegamenti rapidi in un unico pannello."
IT['Light on memory']="Leggero con la memoria"
IT['Maginat uses very little RAM, even on older computers.']="Maginat usa pochissima RAM, anche sui computer meno recenti."
ES['A light and clean desktop']="Un escritorio ligero y limpio"
ES['Xfce on a Linux built from scratch: fast, simple and made to last.']="Xfce sobre un Linux construido desde cero: rápido, sencillo y hecho para durar."
ES['Thousands of programs']="Miles de programas"
ES['Install apps from the Maginat Store with a click.']="Instala aplicaciones desde la Tienda de Maginat con un clic."
ES['Games included']="Juegos incluidos"
ES['Relax with the games that come with Maginat.']="Relájate con los juegos que ya vienen en Maginat."
ES['Make it yours']="Hazlo tuyo"
ES['Choose from many wallpapers and change the look of your desktop.']="Elige entre muchos fondos y cambia el aspecto del escritorio."
ES['Everything at hand']="Todo a mano"
ES['Clock, battery, network and quick links in one panel.']="Reloj, batería, red y accesos rápidos en un solo panel."
ES['Light on memory']="Ligero con la memoria"
ES['Maginat uses very little RAM, even on older computers.']="Maginat usa muy poca RAM, incluso en ordenadores antiguos."
IT['Installing']="Installazione"
ES['Installing']="Instalación"
IT['4) Use the free space of a disk (nothing is erased)']="4) Usa lo spazio libero di un disco (non cancella nulla)"
ES['4) Use the free space of a disk (nothing is erased)']="4) Usar el espacio libre de un disco (no se borra nada)"
IT['<b>Choose the disk</b>\nA new partition will be created in its free space.']="<b>Scegli il disco</b>\nVerrà creata una nuova partizione nel suo spazio libero."
ES['<b>Choose the disk</b>\nA new partition will be created in its free space.']="<b>Elige el disco</b>\nSe creará una nueva partición en su espacio libre."
