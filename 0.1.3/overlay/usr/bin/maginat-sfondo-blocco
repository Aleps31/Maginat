#!/bin/bash
# Maginat - Copyright (C) 2026 Alessandro Pisanu ("Aleps31") - GPL-2.0 (see /usr/share/licenses/COPYRIGHT)
case "$LANG" in it*) L=it;; es*) L=es;; *) L=en;; esac
t() { case "$L" in it) echo "$1";; es) echo "${3:-$2}";; *) echo "$2";; esac; }
export SUDO_ASKPASS=/usr/bin/maginat-askpass
F=$(yad --file --title="$(t 'Sfondo di blocco' 'Lock screen background' 'Fondo de bloqueo')" --filename=/usr/share/backgrounds/maginat/ --file-filter='Immagini | *.jpg *.jpeg *.png *.JPG *.JPEG *.PNG' --add-preview --width=900 --height=560 --center --button="$(t 'Ripristina predefinito' 'Restore default' 'Restaurar predeterminado')":2 --button="$(t 'Annulla' 'Cancel' 'Cancelar')":1 --button=OK:0)
R=$?
case $R in
    0) [ -f "$F" ] || exit 0; sudo -A /usr/sbin/maginat-sfondo-blocco-applica "$F";;
    2) sudo -A /usr/sbin/maginat-sfondo-blocco-applica --reset;;
    *) exit 0;;
esac
if [ $? -eq 0 ]; then
    yad --info --center --title="$(t 'Sfondo di blocco' 'Lock screen background' 'Fondo de bloqueo')" --text="$(t 'Fatto. Lo vedrai al prossimo blocco dello schermo.' 'Done. You will see it the next time the screen is locked.' 'Hecho. Lo verás la próxima vez que se bloquee la pantalla.')" --button=OK:0
else
    yad --error --center --title="$(t 'Sfondo di blocco' 'Lock screen background' 'Fondo de bloqueo')" --text="$(t 'Non è stato possibile cambiare lo sfondo.' 'Could not change the background.' 'No se pudo cambiar el fondo.')" --button=OK:0
fi
