#!/bin/bash
# Maginat - Copyright (C) 2026 Alessandro Pisanu ("Aleps31") - GPL-2.0 (see /usr/share/licenses/COPYRIGHT)
RAD=/
ESCL=()
while getopts r:x: o; do
  case $o in
    r) RAD=$OPTARG;;
    x) ESCL+=("$OPTARG");;
    *) echo "uso: maginat-altri-sistemi [-r radice] [-x dispositivo]..."; exit 1;;
  esac
done
[ -d "$RAD/boot/grub" ] || { echo "manca $RAD/boot/grub"; exit 1; }
OUT=$RAD/boot/grub/altri-sistemi.cfg
if [ -n "$MAGINAT_UEFI" ]; then UEFI=$MAGINAT_UEFI; elif [ -d /sys/firmware/efi ]; then UEFI=1; else UEFI=0; fi
ESPGUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
N=0

pulisci() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._()+/-' | cut -c1-60; }

elenco() {
  if [ -n "$MAGINAT_PROVA" ]; then cut -d'|' -f1 "$MAGINAT_PROVA"; return; fi
  lsblk -lnpo NAME,TYPE -e 7,11 | awk '$2=="part"{print $1}'
}
info() {
  if [ -n "$MAGINAT_PROVA" ]; then
    grep "^$1|" "$MAGINAT_PROVA" | head -1 | cut -d'|' -f"$2"
    return
  fi
  case $2 in
    2) lsblk -dno FSTYPE "$1";;
    3) lsblk -dno UUID "$1";;
    4) lsblk -dno PARTTYPE "$1" | tr 'A-Z' 'a-z';;
  esac
}
monta() {
  local d=$1 f=$2 m o
  if [ -n "$MAGINAT_PROVA" ]; then info "$d" 5; return 0; fi
  m=$(findmnt -rno TARGET -S "$d" | head -1)
  if [ -n "$m" ]; then echo "$m"; return 0; fi
  m=$(mktemp -d /tmp/maginat-scan.XXXXXX) || return 1
  case $f in
    ext2|ext3|ext4) o=ro,noload;;
    ntfs) o=ro; f=ntfs3;;
    *) o=ro;;
  esac
  if mount -t "$f" -o "$o" "$d" "$m" 2>/dev/null; then echo "$m"; else rmdir "$m"; return 1; fi
}
smonta() {
  case $1 in
    /tmp/maginat-scan.*) umount "$1" 2>/dev/null; rmdir "$1" 2>/dev/null;;
  esac
  return 0
}
nome() { basename "$1"; }

{
  echo "# generato da maginat-altri-sistemi: non modificare a mano"
} > "$OUT.nuovo"

voce_efi() {
  local titolo=$1 uuid=${2,,} percorso=$3 classe=$4
  N=$((N+1))
  printf 'menuentry "%s" --class %s --class os {\n    search --no-floppy --fs-uuid --set=root %s\n    chainloader %s\n}\n' "$titolo" "$classe" "$uuid" "$percorso" >> "$OUT.nuovo"
  echo "rilevato: $titolo"
}
voce_bios_windows() {
  local titolo=$1 uuid=${2,,}
  N=$((N+1))
  printf 'menuentry "%s" --class windows --class os {\n    insmod part_msdos\n    insmod ntfs\n    insmod chain\n    search --no-floppy --fs-uuid --set=root %s\n    chainloader +1\n}\n' "$titolo" "$uuid" >> "$OUT.nuovo"
  echo "rilevato: $titolo"
}
voce_linux() {
  local titolo=$1 uuid=${2,,} cfg=$3
  N=$((N+1))
  printf 'menuentry "%s" --class gnu-linux --class os {\n    search --no-floppy --fs-uuid --set=root %s\n    configfile %s\n}\n' "$titolo" "$uuid" "$cfg" >> "$OUT.nuovo"
  echo "rilevato: $titolo"
}

scansiona_esp() {
  local p=$1 uuid=$2 M d n l c
  M=$(monta "$p" vfat) || return 0
  if [ -f "$M/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
    voce_efi "Windows ($(nome "$p"))" "$uuid" "/EFI/Microsoft/Boot/bootmgfw.efi" windows
  fi
  for d in "$M"/EFI/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    case "${n,,}" in microsoft|boot|maginat) continue;; esac
    l=""
    for c in shimx64.efi shim.efi grubx64.efi grub.efi systemd-bootx64.efi refind_x64.efi bootx64.efi; do
      if [ -f "$d$c" ]; then l=$c; break; fi
    done
    [ -n "$l" ] || continue
    voce_efi "$(pulisci "$n") ($(nome "$p"))" "$uuid" "/EFI/$n/$l" gnu-linux
  done
  smonta "$M"
}
scansiona_ntfs() {
  local p=$1 uuid=$2 M
  M=$(monta "$p" ntfs) || return 0
  if [ -f "$M/bootmgr" ] || [ -f "$M/ntldr" ] || [ -f "$M/NTLDR" ]; then
    voce_bios_windows "Windows ($(nome "$p"))" "$uuid"
  fi
  smonta "$M"
}
scansiona_linux() {
  local p=$1 fs=$2 uuid=$3 M c nm
  M=$(monta "$p" "$fs") || return 0
  for c in boot/grub/grub.cfg grub/grub.cfg boot/grub2/grub.cfg grub2/grub.cfg; do
    if [ -f "$M/$c" ]; then
      nm=""
      [ -f "$M/etc/os-release" ] && nm=$(sed -n 's/^PRETTY_NAME=//p' "$M/etc/os-release" | head -1 | tr -d '"')
      nm=$(pulisci "$nm")
      [ -n "$nm" ] || nm=Linux
      voce_linux "$nm ($(nome "$p"))" "$uuid" "/$c"
      break
    fi
  done
  smonta "$M"
}

for p in $(elenco); do
  salta=0
  for x in "${ESCL[@]}"; do
    [ -n "$x" ] || continue
    case "$p" in "$x"*) salta=1;; esac
  done
  [ $salta = 1 ] && continue
  fs=$(info "$p" 2)
  uuid=$(info "$p" 3)
  pt=$(info "$p" 4)
  [ -n "$uuid" ] || continue
  case "$fs" in
    vfat)
      if [ "$UEFI" = 1 ] && [ "$pt" = "$ESPGUID" ]; then scansiona_esp "$p" "$uuid"; fi;;
    ntfs)
      if [ "$UEFI" != 1 ]; then scansiona_ntfs "$p" "$uuid"; fi;;
    ext2|ext3|ext4|btrfs|xfs)
      if [ "$UEFI" != 1 ]; then scansiona_linux "$p" "$fs" "$uuid"; fi;;
  esac
done

mv "$OUT.nuovo" "$OUT"
echo "altri sistemi trovati: $N"
exit 0
