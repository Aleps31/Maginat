case "$LANG" in it*) L=it;; es*) L=es;; *) L=en;; esac
case "$L" in it) T="Password richiesta"; M="Inserisci la tua password:";; es) T="Contraseña necesaria"; M="Introduce tu contraseña:";; *) T="Password required"; M="Enter your password:";; esac
yad --entry --hide-text --title="$T" --text="$M" --center --width=320
