#!/bin/bash
# Maginat - Copyright (C) 2026 Alessandro Pisanu ("Aleps31") - GPL-2.0 (see /usr/share/licenses/COPYRIGHT)
. /etc/os-release
case "$LANG" in it*) L=it;; es*) L=es;; *) L=en;; esac
t() { case "$L" in it) echo "$1";; es) echo "${3:-$2}";; *) echo "$2";; esac; }
R=$(curl -fsS --max-time 15 "https://api.github.com/repos/Aleps31/Maginat/releases?per_page=1" 2>/dev/null) || { t "Impossibile controllare: nessuna connessione." "Cannot check: no connection." "Imposible comprobar: no hay conexión."; exit 2; }
N=$(printf '%s' "$R" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"$//; s/^v//')
[ -n "$N" ] || { t "Impossibile leggere l'ultima versione." "Could not read the latest version." "No se pudo leer la última versión."; exit 2; }
M=$(printf '%s\n%s\n' "$N" "$VERSION" | sort -V | tail -1)
if [ "$N" != "$VERSION" ] && [ "$M" = "$N" ]; then
    t "Nuova versione disponibile: Maginat $N (hai la $VERSION)." "New version available: Maginat $N (you have $VERSION)." "Nueva versión disponible: Maginat $N (tienes la $VERSION)."
    t "Scaricala da: https://github.com/Aleps31/Maginat/releases" "Download it from: https://github.com/Aleps31/Maginat/releases" "Descárgala desde: https://github.com/Aleps31/Maginat/releases"
else
    t "Maginat $VERSION e' aggiornata." "Maginat $VERSION is up to date." "Maginat $VERSION está actualizada."
fi
