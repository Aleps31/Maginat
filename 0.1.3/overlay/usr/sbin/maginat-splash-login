[ -e /etc/maginat-lang ] || exit 0
[ -x /usr/bin/maginat-splash ] || exit 0
[ -n "$XAUTHORITY" ] || export XAUTHORITY="/run/lightdm/root/$DISPLAY"
/usr/bin/maginat-splash >/dev/null 2>&1 &
exit 0
